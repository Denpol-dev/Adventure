<Window x:Class="Foxnet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Foxnet.Desktop"
        xmlns:vm="clr-namespace:Foxnet.Desktop.ViewModels"
        xmlns:views="clr-namespace:Foxnet.Desktop.Views"
        x:Name="Shell"
        Title="FOXNET Desktop"
        Width="1160" Height="760" MinWidth="880" MinHeight="615"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:PageMatchConverter x:Key="PageMatch"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="47"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                    <Border Width="27" Height="25" Background="{DynamicResource AccentPanelBrush}" CornerRadius="6">
                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0,1 L 5,4 L 10,4 L 15,1 L 14,10 L 7.5,15 L 1,10 Z M 4,8 L 6,9 M 11,8 L 9,9"/>
                    </Border>
                    <TextBlock Text="FOXNET" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,1"/>
                    <TextBlock Text="DESKTOP" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,3,4,2"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize"
                            ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                        <Path Data="M 0,5 H 10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="ToggleMaximized" ToolTip="Развернуть или восстановить"
                            AutomationProperties.Name="Развернуть или восстановить">
                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0,0 H 9 V 8 H 0 Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, ElementName=Shell}" Value="Maximized">
                                            <Setter Property="Data" Value="M 0,3 H 7 V 10 H 0 Z M 3,3 V 0 H 10 V 7 H 7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="CloseWindow"
                            ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource WorkspaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,1,0" Padding="15,28,15,19"
                    Visibility="{Binding Ready, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                            Padding="6,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Online" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel IsEnabled="{Binding Ready}">
                        <TextBlock Text="РАБОЧАЯ СТАНЦИЯ" Style="{StaticResource Eyebrow}" Margin="9,0,0,15"/>
                        <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Личный кабинет"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Profile}"
                                Tag="{Binding Page, Converter={StaticResource PageMatch}, ConverterParameter=Profile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Width="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Личный кабинет" Margin="9,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Документы"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Documents}"
                                Tag="{Binding Page, Converter={StaticResource PageMatch}, ConverterParameter=Documents}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Width="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Документы" Margin="9,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Сообщения"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Messages}"
                                Tag="{Binding Page, Converter={StaticResource PageMatch}, ConverterParameter=Messages}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" Width="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Сообщения" Margin="9,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" AutomationProperties.Name="FOXNET Device"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Devices}"
                                Tag="{Binding Page, Converter={StaticResource PageMatch}, ConverterParameter=Devices}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Width="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="FOXNET Device" Margin="9,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid Margin="28,23,28,24" Visibility="{Binding Ready, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="{Binding SectionCode}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Title}" FontSize="33" FontWeight="SemiBold" Margin="0,4,0,3"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="14.5"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <views:ProfileView DataContext="{Binding Profile}"
                                           Visibility="{Binding DataContext.Page, ElementName=Shell, Converter={StaticResource PageMatch}, ConverterParameter=Profile}"/>
                        <views:DocumentsView DataContext="{Binding Documents}"
                                             Visibility="{Binding DataContext.Page, ElementName=Shell, Converter={StaticResource PageMatch}, ConverterParameter=Documents}"/>
                        <views:MessagesView DataContext="{Binding Messages}"
                                            Visibility="{Binding DataContext.Page, ElementName=Shell, Converter={StaticResource PageMatch}, ConverterParameter=Messages}"/>
                        <views:DevicesView DataContext="{Binding Devices}"
                                           Visibility="{Binding DataContext.Page, ElementName=Shell, Converter={StaticResource PageMatch}, ConverterParameter=Devices}"/>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.ColumnSpan="2" Visibility="{Binding SignInVisible, Converter={StaticResource BoolVisibility}}">
                <views:SignInView DataContext="{Binding SignIn}"/>
            </Grid>
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Loading, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="Загрузка FOXNET" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource RaisedBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <Border Grid.ColumnSpan="2" MaxWidth="470" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartupError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Не удалось открыть FOXNET" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding StartupError}" Style="{StaticResource MutedText}" Margin="0,8,0,14"
                               Foreground="{DynamicResource ErrorBrush}"/>
                    <Button Content="Повторить" Command="{Binding InitializeCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
