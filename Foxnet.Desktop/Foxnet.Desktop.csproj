<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Foxnet.Desktop</AssemblyName>
    <Product>FOXNET Desktop</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <ProjectReference Include="../Foxnet.Session/Foxnet.Session.csproj" />
    <ProjectReference Include="../Adventure/Adventure.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed" />
  </ItemGroup>

  <Target Name="CopyAdventureForDesktop" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../Adventure/Adventure.csproj" Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_AdventureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_AdventureOutput>@(_AdventureTarget->'%(RootDir)%(Directory)')</_AdventureOutput>
    </PropertyGroup>
    <ItemGroup>
      <_AdventureProgram Include="$(_AdventureOutput)**/*" Exclude="$(_AdventureOutput)**/*.pdb" />
    </ItemGroup>
    <Error Condition="!Exists('$(_AdventureOutput)Adventure.exe')" Text="Adventure.exe is missing from the console build." />
    <Copy SourceFiles="@(_AdventureProgram)" DestinationFiles="@(_AdventureProgram->'$(TargetDir)Console/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAdventureWithDesktop" AfterTargets="Publish">
    <ItemGroup>
      <_AdventureDistribution Include="$(TargetDir)Console/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AdventureDistribution)" DestinationFiles="@(_AdventureDistribution->'$(PublishDir)Console/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
