<UserControl x:Class="Foxnet.Desktop.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.48*" MinWidth="223"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="13">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,4,6,13">
                    <TextBlock Text="Библиотека" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Полученные документы" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Полученные документы">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="27" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Background="{DynamicResource RaisedBrush}" CornerRadius="6">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Format}" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Здесь появятся вложения и файлы, полученные во время игры."
                               Style="{StaticResource MutedText}" Margin="6,5"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="50" Height="50" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="22"/>
                    </Border>
                    <TextBlock Text="Просмотр документа" Style="{StaticResource SectionTitle}"
                               TextAlignment="Center" Margin="0,14,0,5"/>
                    <TextBlock Text="Выберите документ в библиотеке, чтобы открыть его здесь."
                               Style="{StaticResource MutedText}" TextAlignment="Center"/>
                </StackPanel>
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Format}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,3,0,2"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding Selected.Source}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,13,0"/>
                                <TextBlock Text="{Binding Selected.Date}" Style="{StaticResource MutedText}" FontSize="12"/>
                            </WrapPanel>
                            <Button Content="Открыть в системе" Command="{Binding OpenExternallyCommand}"
                                    Visibility="{Binding CanOpenExternally, Converter={StaticResource BoolVisibility}}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="32" FontSize="12" Padding="11,5"/>
                            <Button Content="Передать материал" Command="{Binding SendMaterialCommand}" Style="{StaticResource PrimaryButton}"
                                    Visibility="{Binding HasOffer, Converter={StaticResource BoolVisibility}}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding PublicationState}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Notice}" Style="{StaticResource NoticeText}"/>
                            <Border Style="{StaticResource ErrorBanner}">
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <FlowDocumentScrollViewer Grid.Row="1" Document="{Binding Preview}" IsToolBarVisible="False"
                                              IsSelectionEnabled="True" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPreview, Converter={StaticResource BoolVisibility}}"
                                              AutomationProperties.Name="Текст документа"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
