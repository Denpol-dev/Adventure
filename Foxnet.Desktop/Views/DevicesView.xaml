<UserControl x:Class="Foxnet.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.44*" MinWidth="204"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="13">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,4,6,13">
                    <TextBlock Text="Устройства" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Доступные узлы сети" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Доступные устройства" IsEnabled="{Binding NotBusy}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="29" Height="29" Background="{DynamicResource RaisedBrush}" CornerRadius="6"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Text" Value="{Binding Kind}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="satellite">
                                                            <Setter Property="Text" Value="Спутник"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Доступных устройств пока нет." Style="{StaticResource MutedText}" Margin="6,5"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="Выберите устройство из списка."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDevice}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasDevice, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <Border CornerRadius="13,13,0,0" Background="{DynamicResource HeroBrush}" Padding="20,17">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="53" Height="53" Background="{DynamicResource AccentPanelBrush}" CornerRadius="11"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="24"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Selected.Name}" FontSize="27" FontWeight="SemiBold" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Margin="20,16,20,18">
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}" Margin="0,0,7,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selected.Connected}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,0,7">
                                    <TextBlock Text="{Binding AuthorizationLabel}" FontSize="12.5"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="7,0,0,7"
                                        Visibility="{Binding HasExpedition, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ExpeditionLabel}" FontSize="12.5"/>
                                </Border>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding NeedsAuthorization, Converter={StaticResource BoolVisibility}}"
                                        IsEnabled="{Binding NotBusy}" Margin="0,7,0,0">
                                <TextBlock Text="Авторизация FOXNET" Style="{StaticResource SectionTitle}" FontSize="18"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Логин" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox x:Name="LoginInput" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Логин" MaxLength="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Пароль" FontSize="12" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Пароль"
                                                     MaxLength="100" KeyDown="PasswordKeyDown"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Авторизоваться и подключиться" Style="{StaticResource PrimaryButton}"
                                        Click="Authorize" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,7,0,0" Visibility="{Binding ShowConnect, Converter={StaticResource BoolVisibility}}">
                                <Button Content="Подключиться" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Margin="0,7,0,0" Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolVisibility}}">
                                <Button Content="Отключиться" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource RaisedBrush}" BorderThickness="0" Margin="0,13,0,0"
                                         Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
                            <Border Style="{StaticResource ErrorBanner}">
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
