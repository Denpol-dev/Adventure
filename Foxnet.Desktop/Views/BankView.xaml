<UserControl x:Class="Foxnet.Desktop.Views.BankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PaymentRow">
            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,7">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                    Visibility="{Binding Pending, Converter={StaticResource BoolVisibility}}">
                            <Button Content="Перевести" Style="{StaticResource PrimaryButton}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding Request.Incoming, Converter={StaticResource BoolVisibility}}"/>
                            <Button Content="Отменить" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Request.Incoming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Request.Nickname}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Request.Purpose}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Image DockPanel.Dock="Right" Source="/Foxnet.Desktop;component/Assets/haesei.png" Width="176" Margin="12,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="ДОСТУПНО" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Balance}" FontSize="37" FontWeight="SemiBold" Margin="0,3,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Перевести" Command="{Binding StartTransferCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Запросить" Command="{Binding StartRequestCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding Editing, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <TextBlock Text="Получатель" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding Recipient}" DisplayMemberPath="Nickname"
                              Padding="6" AutomationProperties.Name="Получатель"/>
                    <TextBlock Text="Сумма (¢)" Style="{StaticResource MutedText}" Margin="0,9,0,4"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" MaxLength="19" AutomationProperties.Name="Сумма (¢)"/>
                    <TextBlock Text="Назначение" Style="{StaticResource MutedText}" Margin="0,9,0,4"/>
                    <TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" MaxLength="240" AutomationProperties.Name="Назначение"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Подтвердить" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Закрыть" Command="{Binding CloseFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Notice}" Style="{StaticResource NoticeText}"/>
            <Border Style="{StaticResource ErrorBanner}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Входящие запросы" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Incoming}" ItemTemplate="{StaticResource PaymentRow}"/>
                    <TextBlock Text="Исходящие запросы" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>
                    <ItemsControl ItemsSource="{Binding Outgoing}" ItemTemplate="{StaticResource PaymentRow}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="История операций" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,7">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Entry.Nickname}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Entry.Purpose}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
