<UserControl x:Class="Foxnet.Desktop.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.52*" MinWidth="225"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="13">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Собеседники" Style="{StaticResource SectionTitle}" Margin="6,4,6,13"/>
                <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Список контактов">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left" Content="{Binding Avatar}" ContentTemplate="{StaticResource NpcAvatar}" Margin="0,0,9,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding UnreadCount, StringFormat=Непрочитано: {0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20"
                          Visibility="{Binding HasDossier, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ContentControl DockPanel.Dock="Left" Content="{Binding Dossier.Contact.Avatar}" ContentTemplate="{StaticResource NpcAvatar}"
                                        LayoutTransform="{StaticResource DossierAvatarScale}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Dossier.Contact.Nickname}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Dossier.Contact.Summary}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,4"><Run Text="Имя: "/><Run Text="{Binding Dossier.Contact.Name, Mode=OneWay, TargetNullValue=неизвестно}"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Возраст: "/><Run Text="{Binding Dossier.Contact.Age, Mode=OneWay, TargetNullValue=неизвестен}"/></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Деятельность: "/><Run Text="{Binding Dossier.Contact.Organization, Mode=OneWay, TargetNullValue=неизвестна}"/></TextBlock>
                    <TextBlock Text="Собеседник заблокировал переписку" Foreground="{DynamicResource ErrorBrush}" Margin="0,7,0,0"
                               Visibility="{Binding Dossier.Contact.Blocked, Converter={StaticResource BoolVisibility}}"/>
                    <Button Content="Открыть переписку" Command="{Binding OpenChatCommand}" HorizontalAlignment="Left" Margin="0,12,0,19"/>
                    <TextBlock Text="ИЗВЕСТНЫЕ СВЕДЕНИЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,9">
                                    <TextBlock Text="{Binding Fact.Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="ИСТОРИЯ ВЗАИМОДЕЙСТВИЙ" Style="{StaticResource Eyebrow}" Margin="0,9,0,7"/>
                    <ItemsControl ItemsSource="{Binding Dossier.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="МОИ ЗАМЕТКИ" Style="{StaticResource Eyebrow}" Margin="0,14,0,7"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="105"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Мои заметки"/>
                    <Border Style="{StaticResource ErrorBanner}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
